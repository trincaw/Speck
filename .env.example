# ==============================================================================
# Speck ASR Configuration
# ==============================================================================

# Active Model:
# Choose which ASR engine to load.
# Options (benchmarks in docs/models_report.md):
#   - "parakeet" (NVIDIA Parakeet-TDT v3 0.6B; default, most accurate and fastest)
#   - "whisper" (faster-whisper large-v3-turbo; language lock and hotword biasing)
#   - "nemotron" (NVIDIA Nemotron 3.5 ASR Streaming 0.6B; native streaming, lowest latency)
#   - "voxtral" (Mistral Voxtral Mini Transcribe 2, API)
#   - Full HuggingFace / CTranslate2 repo ID
SPECK_MODEL=parakeet

# Device configuration (optional: 'cuda', 'cpu', or leave empty for auto-detect)
# SPECK_DEVICE=cuda

# Precision (optional: 'float16', 'bfloat16', 'float32', or leave empty for auto)
# SPECK_DTYPE=float16

# ==============================================================================
# Mistral AI / Voxtral Configuration
# ==============================================================================
# Set your Mistral API key to use Voxtral Mini Transcribe 2 in API mode:
MISTRAL_API_KEY=

# Voxtral model identifier:
# - "voxtral-mini-latest" (recommended, targets Voxtral Mini Transcribe 2)
# - "voxtral-mini-transcribe-2"
# - "mistralai/Voxtral-Mini-4B-Realtime-2602" (for local HuggingFace weights)
VOXTRAL_MODEL=voxtral-mini-latest

# Voxtral execution backend:
# - "api"   : Mistral Audio Transcriptions Cloud API (fast, low resource, requires MISTRAL_API_KEY)
# - "local" : HuggingFace local model execution via transformers
VOXTRAL_BACKEND=api

# Optional custom API endpoint (defaults to official Mistral audio transcriptions endpoint)
# VOXTRAL_API_URL=https://api.mistral.ai/v1/audio/transcriptions

# Live speaker classification: cosine similarity needed to match a known speaker (default: 0.35).
# Raise it if different people get merged, lower it if one person gets split.
# SPECK_SPEAKER_THRESHOLD=0.35

# ==============================================================================
# Accuracy
# ==============================================================================
# Default language: locks Whisper to one language (e.g. en, it) or 'auto' to detect it.
# SPECK_LANGUAGE=auto

# Comma-separated domain vocabulary (names, jargon): biases Whisper and corrects near-miss words in all engines.
# SPECK_HOTWORDS=Avvale,Kubernetes

# Whisper beam width (default: 5) and CTranslate2 compute type (float16 on CUDA, int8 on CPU).
# SPECK_BEAM_SIZE=5
# SPECK_WHISPER_COMPUTE_TYPE=float16

# DC removal + peak normalization of offline audio before inference (default: 1).
# SPECK_NORMALIZE_AUDIO=1
