# ==============================================================================
# Spek ASR Configuration
# ==============================================================================

# Active Model:
# Choose which ASR engine to load.
# Options:
#   - "nemotron" (NVIDIA Nemotron 3.5 ASR Streaming 0.6B FastConformer-RNNT)
#   - "voxtral" or "voxtral-mini-transcribe-2" (Mistral Voxtral Mini Transcribe 2)
#   - "sherpa-onnx" (speaker diarization + Whisper ONNX, live speaker tagging)
#   - Full HuggingFace model repo ID (e.g. "nvidia/nemotron-3.5-asr-streaming-0.6b")
SPEK_MODEL=nemotron

# Device configuration (optional: 'cuda', 'cpu', or leave empty for auto-detect)
# SPEK_DEVICE=cuda

# Precision (optional: 'float16', 'bfloat16', 'float32', or leave empty for auto)
# SPEK_DTYPE=float16

# ==============================================================================
# Mistral AI / Voxtral Configuration
# ==============================================================================
# Set your Mistral API key to use Voxtral Mini Transcribe 2 in API mode:
MISTRAL_API_KEY=

# Voxtral model identifier:
# - "voxtral-mini-latest" (recommended, targets Voxtral Mini Transcribe 2)
# - "voxtral-mini-transcribe-2"
# - "mistralai/Voxtral-Mini-4B-Realtime-2602" (for local HuggingFace weights)
VOXTRAL_MODEL=voxtral-mini-latest

# Voxtral execution backend:
# - "api"   : Mistral Audio Transcriptions Cloud API (fast, low resource, requires MISTRAL_API_KEY)
# - "local" : HuggingFace local model execution via transformers
VOXTRAL_BACKEND=api

# Optional custom API endpoint (defaults to official Mistral audio transcriptions endpoint)
# VOXTRAL_API_URL=https://api.mistral.ai/v1/audio/transcriptions

# ==============================================================================
# Sherpa-ONNX Speech Tagging & Diarization Configuration
# ==============================================================================
# Model alias options: "sherpa" or "sherpa-onnx"
# SPEK_MODEL=sherpa-onnx

# Custom speaker segmentation model (defaults to csukuangfj/sherpa-onnx-pyannote-segmentation-3-0)
# SPEK_SHERPA_SEGMENTATION_MODEL=

# Custom speaker embedding model (defaults to csukuangfj/speaker-embedding-models/nemo_en_titanet_small.onnx).
# Thresholds below are tuned for it; retune both if you swap models.
# SPEK_SHERPA_EMBEDDING_MODEL=

# Number of speaker clusters: <= 0 to auto-detect number of speakers dynamically, or set fixed count (e.g. 2)
# SPEK_SHERPA_NUM_CLUSTERS=-1

# Diarization clustering distance threshold (default: 0.9)
# SPEK_SHERPA_THRESHOLD=0.9

# Speaker speech tag format in text output:
# - "block"  : [Speaker 0]: Hello...\n[Speaker 1]: Hi...
# - "inline" : [Speaker 0] Hello... [Speaker 1] Hi...
# SPEK_SHERPA_TAG_FORMAT=block

# Computation threads for ONNX runtime (default: 2)
# SPEK_SHERPA_NUM_THREADS=2

# Live speaker classification: cosine similarity needed to match a known speaker (default: 0.35).
# Raise it if different people get merged, lower it if one person gets split.
# SPEK_SPEAKER_THRESHOLD=0.35

# ==============================================================================
# Server Configuration
# ==============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

